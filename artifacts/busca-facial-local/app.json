{
  "expo": {
    "name": "Search Face Local",
    "slug": "busca-facial-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "busca-facial-local",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.buscafacial.local",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "allowBackup": false,
      "permissions": [
        "WAKE_LOCK",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS"
      ]
    },
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080B14"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o Search Face Local acesse suas fotos para procurar rostos localmente.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "react-native-fast-tflite",
      "./plugins/withNotifeeForegroundService",
      "./plugins/withNotificationIcon",
      "./plugins/withFaceLandmarkerModel",
      "./plugins/withFaceRecognitionModel",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6305008666977043~9018991848",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "18d47682-9c84-45e3-98c3-3476a8544551"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-6305008666977043~9018991848",
    "delay_app_measurement_init": true
  }
}
